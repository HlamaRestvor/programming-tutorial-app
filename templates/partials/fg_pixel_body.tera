{#- ============================================================
    Pixel Ferris — kawaii pixel-art crab, 18×14 cells.
    Based on references/orange_crab.svg, kawaii-fied: glossy
    top highlight, double eye sparkles, blush and a ∪ smile.
    Caller provides the <svg> tag with viewBox="0 0 18 14"
    and shape-rendering="crispEdges".
    ============================================================ -#}
<!-- dark outline & shading (#A52B00) -->
<path fill="#A52B00" d="
  M5,1 h1 v1 h-1 z M8,1 h2 v1 h-2 z M12,1 h1 v1 h-1 z
  M4,2 h10 v1 h-10 z
  M3,3 h12 v1 h-12 z
  M1,4 h2 v1 h-2 z M15,4 h2 v1 h-2 z
  M0,5 h2 v2 h-2 z M16,5 h2 v2 h-2 z
  M1,7 h2 v1 h-2 z M15,7 h2 v1 h-2 z
  M3,9 h12 v1 h-12 z
  M2,10 h2 v2 h-2 z M5,10 h2 v2 h-2 z M11,10 h2 v2 h-2 z M14,10 h2 v2 h-2 z
  M1,12 h2 v1 h-2 z M6,12 h1 v1 h-1 z M11,12 h1 v1 h-1 z M15,12 h2 v1 h-2 z
"/>
<!-- shell & claws (#F74C00) -->
<path fill="#F74C00" d="
  M5,2 h8 v1 h-8 z
  M4,3 h10 v1 h-10 z
  M3,4 h12 v5 h-12 z
  M1,5 h2 v2 h-2 z M15,5 h2 v2 h-2 z
  M4,9 h10 v1 h-10 z
"/>
<!-- glossy top highlight (#FF8A50) -->
<path fill="#FF8A50" d="
  M4,3 h4 v1 h-4 z M10,3 h4 v1 h-4 z
"/>
<!-- big glossy eyes (#111111) -->
<path fill="#111111" d="
  M6,5 h2 v3 h-2 z
  M10,5 h2 v3 h-2 z
"/>
<!-- eye sparkles (#FFFFFF) -->
<path fill="#FFFFFF" d="
  M6,5 h1 v1 h-1 z
  M10,5 h1 v1 h-1 z
  M7,7 h1 v1 h-1 z
  M11,7 h1 v1 h-1 z
"/>
<!-- blush (#FF9AA8) -->
<path fill="#FF9AA8" d="
  M4,8 h1 v1 h-1 z
  M13,8 h1 v1 h-1 z
"/>
<!-- happy ∪ smile (#111111) -->
<path fill="#111111" d="
  M7,8 h1 v1 h-1 z
  M10,8 h1 v1 h-1 z
  M8,9 h2 v1 h-2 z
"/>
