{#- ============================================================
    Ferris Grumpy — the kawaii ANGRY Ferris for wrong answers.
    Same beloved dome shell & pincer mitts, but with:
    * thick slanted anime brows (V-shaped anger),
    * glossy eyes with a first tear welling up,
    * puffed blush cheeks, a pouty squiggle mouth,
    * the classic anime anger cross 💢 pulsing on the shell.
    Caller provides the <svg> tag: viewBox="0 0 200 170".
    ============================================================ -#}
<g class="fg-grump">
  <defs>
    <radialGradient id="fgGrumpShell" cx="0.5" cy="0.3" r="0.95">
      <stop offset="0" stop-color="#FF8A50"/>
      <stop offset="0.62" stop-color="#F74C00"/>
      <stop offset="1" stop-color="#C33B00"/>
    </radialGradient>
  </defs>

  <!-- soft ground shadow -->
  <ellipse cx="100" cy="159" rx="56" ry="7" fill="#A52B00" opacity="0.18"/>

  <!-- stubby legs, firmly planted (stomping mood) -->
  <g stroke="#C43A00" stroke-width="9" stroke-linecap="round" fill="none">
    <path d="M60 144 L40 156"/>
    <path d="M72 150 L58 162"/>
    <path d="M86 153 L80 164"/>
    <path d="M140 144 L160 156"/>
    <path d="M128 150 L142 162"/>
    <path d="M114 153 L120 164"/>
  </g>

  <!-- dome shell -->
  <path d="M38 130 C38 72 62 40 100 40 C138 40 162 72 162 130 C162 150 140 156 100 156 C60 156 38 150 38 130 Z" fill="url(#fgGrumpShell)"/>

  <!-- glossy anime sheen -->
  <ellipse cx="82" cy="64" rx="26" ry="13" transform="rotate(-16 82 64)" fill="#FFFFFF" opacity="0.20"/>

  <!-- anime anger cross 💢 — pulsing pop on the upper shell -->
  <g class="fg-grump-vein" stroke="#FF5D8F" stroke-width="4" stroke-linecap="round" fill="none">
    <path d="M148 52 l0 11"/>
    <path d="M142.5 57.5 l11 0"/>
    <path d="M144.4 53.9 l7.2 7.2"/>
    <path d="M151.6 53.9 l-7.2 7.2"/>
  </g>
  <g class="fg-grump-vein v2" stroke="#FF5D8F" stroke-width="3" stroke-linecap="round" fill="none" opacity="0.8">
    <path d="M163 64 l0 8"/>
    <path d="M159 68 l8 0"/>
  </g>

  <!-- crossed arms: pincer mitts pressed against the cheeks (hmph!) -->
  <g>
    <path d="M52 124 C40 116 33 104 34 90" stroke="#E4390F" stroke-width="12" stroke-linecap="round" fill="none"/>
    <ellipse cx="36" cy="78" rx="14" ry="10" transform="rotate(-30 36 78)" fill="#F74C00"/>
    <path d="M38 71 L34 80" stroke="#A52B00" stroke-width="3" stroke-linecap="round"/>
  </g>
  <g>
    <path d="M148 124 C160 116 167 104 166 90" stroke="#E4390F" stroke-width="12" stroke-linecap="round" fill="none"/>
    <ellipse cx="164" cy="78" rx="14" ry="10" transform="rotate(30 164 78)" fill="#F74C00"/>
    <path d="M162 71 L166 80" stroke="#A52B00" stroke-width="3" stroke-linecap="round"/>
  </g>

  <!-- thick slanted anime brows: anger! -->
  <g class="fg-grump-brows" stroke="#7A2A10" stroke-width="6" stroke-linecap="round" fill="none">
    <path d="M54 78 L86 88"/>
    <path d="M146 78 L114 88"/>
  </g>

  <!-- huge glossy eyes, teary -->
  <g>
    <circle cx="70" cy="102" r="15" fill="#3A2417"/>
    <circle cx="65" cy="97" r="5.4" fill="#FFFFFF"/>
    <circle cx="75" cy="107" r="2.4" fill="#FFFFFF" opacity="0.85"/>
    <ellipse class="fg-grump-tear t1" cx="82" cy="112" rx="3.4" ry="5" fill="#9BD3FF" opacity="0.9"/>
  </g>
  <g>
    <circle cx="130" cy="102" r="15" fill="#3A2417"/>
    <circle cx="125" cy="97" r="5.4" fill="#FFFFFF"/>
    <circle cx="135" cy="107" r="2.4" fill="#FFFFFF" opacity="0.85"/>
    <ellipse class="fg-grump-tear t2" cx="118" cy="112" rx="3.4" ry="5" fill="#9BD3FF" opacity="0.9"/>
  </g>

  <!-- puffed kawaii blush cheeks -->
  <ellipse cx="46" cy="118" rx="12" ry="7.5" fill="#FF8FA3" opacity="0.75"/>
  <ellipse cx="154" cy="118" rx="12" ry="7.5" fill="#FF8FA3" opacity="0.75"/>

  <!-- pouty squiggle mouth (hmph! >:C) -->
  <path d="M84 126 Q90 119 96 126 Q102 133 108 126" fill="none" stroke="#7A2A10" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/>
</g>
