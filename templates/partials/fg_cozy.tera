{#- ============================================================
    Ferris Cozy — the smooth semi-anime kawaii Ferris.
    Huge glossy eyes with anime highlights, blush, ω-mouth,
    stubby legs and raised pincer mitts.
    Palette follows the original crab: #F74C00 shell,
    #A52B00 shading, warm dark eyes.
    Caller provides the <svg> tag: viewBox="0 0 200 170".
    ============================================================ -#}
<g class="fg-cozy">
  <defs>
    <radialGradient id="fgCozyShell" cx="0.5" cy="0.3" r="0.95">
      <stop offset="0" stop-color="#FF8A50"/>
      <stop offset="0.62" stop-color="#F74C00"/>
      <stop offset="1" stop-color="#C33B00"/>
    </radialGradient>
  </defs>

  <!-- soft ground shadow -->
  <ellipse cx="100" cy="159" rx="56" ry="7" fill="#A52B00" opacity="0.18"/>

  <!-- stubby legs (behind the shell) -->
  <g stroke="#C43A00" stroke-width="9" stroke-linecap="round" fill="none">
    <path d="M60 144 L40 156"/>
    <path d="M72 150 L58 162"/>
    <path d="M86 153 L80 164"/>
    <path d="M140 144 L160 156"/>
    <path d="M128 150 L142 162"/>
    <path d="M114 153 L120 164"/>
  </g>

  <!-- dome shell -->
  <path d="M38 130 C38 72 62 40 100 40 C138 40 162 72 162 130 C162 150 140 156 100 156 C60 156 38 150 38 130 Z" fill="url(#fgCozyShell)"/>

  <!-- glossy anime sheen -->
  <ellipse cx="82" cy="64" rx="26" ry="13" transform="rotate(-16 82 64)" fill="#FFFFFF" opacity="0.20"/>

  <!-- raised left pincer mitt -->
  <g>
    <path d="M52 122 C36 110 28 94 31 76" stroke="#E4390F" stroke-width="12" stroke-linecap="round" fill="none"/>
    <ellipse cx="27" cy="56" rx="15" ry="10" transform="rotate(-38 27 56)" fill="#F74C00"/>
    <ellipse cx="32" cy="73" rx="15" ry="10" transform="rotate(-4 32 73)" fill="#F74C00"/>
    <path d="M31 62 L27 71" stroke="#A52B00" stroke-width="3" stroke-linecap="round"/>
  </g>
  <!-- raised right pincer mitt -->
  <g>
    <path d="M148 122 C164 110 172 94 169 76" stroke="#E4390F" stroke-width="12" stroke-linecap="round" fill="none"/>
    <ellipse cx="173" cy="56" rx="15" ry="10" transform="rotate(38 173 56)" fill="#F74C00"/>
    <ellipse cx="168" cy="73" rx="15" ry="10" transform="rotate(4 168 73)" fill="#F74C00"/>
    <path d="M169 62 L173 71" stroke="#A52B00" stroke-width="3" stroke-linecap="round"/>
  </g>

  <!-- huge glossy eyes -->
  <circle cx="70" cy="100" r="16" fill="#3A2417"/>
  <circle cx="65" cy="95" r="6" fill="#FFFFFF"/>
  <circle cx="75" cy="105" r="2.6" fill="#FFFFFF" opacity="0.85"/>
  <circle cx="130" cy="100" r="16" fill="#3A2417"/>
  <circle cx="125" cy="95" r="6" fill="#FFFFFF"/>
  <circle cx="135" cy="105" r="2.6" fill="#FFFFFF" opacity="0.85"/>

  <!-- blush -->
  <ellipse cx="46" cy="116" rx="11" ry="6.5" fill="#FF8FA3" opacity="0.55"/>
  <ellipse cx="154" cy="116" rx="11" ry="6.5" fill="#FF8FA3" opacity="0.55"/>

  <!-- happy ω mouth -->
  <path d="M84 122 Q92 132 100 124 Q108 132 116 122" fill="none" stroke="#7A2A10" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/>
</g>
