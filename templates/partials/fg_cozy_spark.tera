{#- Cozy Ferris surrounded by twinkling 4-ray sparkles.
    Sparkle groups hold the translate/scale; the inner path is
    animated by .fg-spark (see layout.css: fg-twinkle).
    Caller provides the <svg> tag: viewBox="0 0 200 170". -#}
{% include "partials/fg_cozy.tera" %}
<g>
  <g transform="translate(30 34)" fill="#FFE9A8">
    <path class="fg-spark s1" d="M0 -9 C1.3 -2.7 2.7 -1.3 9 0 C2.7 1.3 1.3 2.7 0 9 C-1.3 2.7 -2.7 1.3 -9 0 C-2.7 -1.3 -1.3 -2.7 0 -9 Z"/>
  </g>
  <g transform="translate(176 28) scale(0.7)" fill="#FFC7E0">
    <path class="fg-spark s2" d="M0 -9 C1.3 -2.7 2.7 -1.3 9 0 C2.7 1.3 1.3 2.7 0 9 C-1.3 2.7 -2.7 1.3 -9 0 C-2.7 -1.3 -1.3 -2.7 0 -9 Z"/>
  </g>
  <g transform="translate(164 124) scale(0.55)" fill="#BFD4FF">
    <path class="fg-spark s3" d="M0 -9 C1.3 -2.7 2.7 -1.3 9 0 C2.7 1.3 1.3 2.7 0 9 C-1.3 2.7 -2.7 1.3 -9 0 C-2.7 -1.3 -1.3 -2.7 0 -9 Z"/>
  </g>
  <g transform="translate(20 106) scale(0.62)" fill="#FFE9A8">
    <path class="fg-spark s2" d="M0 -9 C1.3 -2.7 2.7 -1.3 9 0 C2.7 1.3 1.3 2.7 0 9 C-1.3 2.7 -2.7 1.3 -9 0 C-2.7 -1.3 -1.3 -2.7 0 -9 Z"/>
  </g>
</g>
