{#- ============================================================
    Error page shell (shared by 404.tera / 503.tera / 500.tera).
    STANDALONE document — it deliberately does NOT extend base.tera:
    error pages must render even when nothing else works, and they
    are English-only by design.
    Expected context (all optional):
      code          — "404" | "503" | "500" (string)
      error_title   — headline, e.g. "Looks like you're lost"
      error_message — human explanation (escaped below)
      request_path  — the URL path to show in the address chip
    The theme orb is a round BINARY button (no <select>): dark by
    default, otherwise localStorage['fairy_theme'] ('light' wins;
    the main app's 'system' value falls back to dark here).
    ============================================================ -#}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ code | default(value="Error") }} · Ferris &amp; The Rust Garden</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🦀</text></svg>">
  <link rel="stylesheet" href="/static/css/tokens.css">
  <link rel="stylesheet" href="/static/css/error.css">
</head>
<body class="error-body">

  <!-- Round binary theme button: moon ⇄ sun, pure CSS+SVG animation -->
  <button type="button" class="theme-orb" id="theme-orb" aria-label="Toggle dark / light theme" title="Toggle theme">
    <svg class="orb-icon" viewBox="0 0 48 48" aria-hidden="true">
      <g class="orb-moon">
        <path d="M33.5 5.6 A16.8 16.8 0 1 0 42.4 33.4 A13.4 13.4 0 0 1 33.5 5.6 Z" fill="#FFE9A8"/>
        <circle cx="38.6" cy="9.2" r="1.5" fill="#ffffff"/>
        <circle cx="42" cy="15.6" r="1.1" fill="#ffffff"/>
        <circle cx="35.4" cy="4.4" r="0.9" fill="#ffffff"/>
      </g>
      <g class="orb-sun">
        <defs>
          <linearGradient id="orbSunGrad" x1="24" y1="15.8" x2="24" y2="32.2" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#FFE08A"/>
            <stop offset="1" stop-color="#FF9F5A"/>
          </linearGradient>
        </defs>
        <circle cx="24" cy="24" r="8.2" fill="url(#orbSunGrad)"/>
        <g stroke="#FFC24D" stroke-width="2.6" stroke-linecap="round">
          <path d="M24 6.5v3.4M24 38.1v3.4M6.5 24h3.4M38.1 24h3.4M11.6 11.6l2.4 2.4M34 34l2.4 2.4M36.4 11.6 34 14M14 34l-2.4 2.4"/>
        </g>
      </g>
    </svg>
  </button>

  <main class="error-scene">
    <section class="error-card">
      <!-- Ferris is grumpy: the garden path ended here (shared partial) -->
      <div class="error-mascot" aria-hidden="true">
        <svg class="fg-svg" width="118" height="100" viewBox="0 0 200 170" fill="none" xmlns="http://www.w3.org/2000/svg">
          {% include "partials/fg_grumpy.tera" %}
        </svg>
      </div>

      <div class="error-code">{{ code | default(value="404") }}</div>

      <h1 class="error-title">{{ error_title | default(value="Something went astray") }}</h1>

      <p class="error-desc">{{ error_message | escape }}</p>

      <div class="error-chip">
        Address&nbsp;<code id="err-path">{{ request_path | escape }}</code>
      </div>

      <a class="error-home-btn" href="/">←&nbsp;Back home</a>
    </section>
  </main>

  <script>
    (function () {
      // Theme: dark by default; localStorage['fairy_theme'] wins when it
      // says "light" (the main app may store 'dark' | 'light' | 'system';
      // 'system' simply falls back to dark on error pages).
      var theme = 'dark';
      try {
        if (localStorage.getItem('fairy_theme') === 'light') theme = 'light';
      } catch (e) { /* storage disabled */ }
      document.documentElement.setAttribute('data-theme', theme);

      var orb = document.getElementById('theme-orb');
      if (orb) {
        orb.addEventListener('click', function () {
          theme = theme === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', theme);
          try { localStorage.setItem('fairy_theme', theme); } catch (e) { /* ignore */ }
        });
      }

      // The exact URL the visitor requested — straight from the browser
      // (the server-rendered chip text is just the no-JS fallback).
      var pathEl = document.getElementById('err-path');
      if (pathEl) pathEl.textContent = window.location.pathname;
    })();
  </script>
</body>
</html>
