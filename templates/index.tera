{% extends "base.tera" %}

{% block head_extra %}
<link rel="stylesheet" href="/static/css/home.css">
{% endblock %}

{% block content %}
<!-- Hero Section -->
<section class="hero-section">
  <div class="hero-info">
    <div class="version-tag">
      <span>🦀</span>
      <span>{{ translation.badge_mva }} &bull; {{ version }}</span>
    </div>
    <h1 class="hero-title">
      {{ translation.hero_title_1 }} <span class="highlight">{{ translation.hero_title_highlight }}</span> {{ translation.hero_title_2 }}
    </h1>
    <p class="hero-desc">
      {{ translation.hero_desc }}
    </p>
    <div class="hero-actions">
      {#- Green CTA: once quest #1 ("mut") is solved this session, the SSR
          state alone turns the button green and points at /adventures. -#}
      <a id="intro-cta-btn"
         {% if 'rust-01-mutability' in user_stats.completed_quest_ids %}
           href="/adventures?lang={{ lang }}" class="btn-success"
           data-success-text="{{ translation.intro_continue }}"
         {% else %}href="#playground" class="btn-primary"{% endif %}>
        {% if 'rust-01-mutability' in user_stats.completed_quest_ids %}
          <span>🗺️ {{ translation.intro_continue }}</span>
        {% else %}
          <span>🪄 {{ translation.btn_try_puzzle }}</span>
        {% endif %}
      </a>
      <a href="#roadmap" class="btn-secondary">
        <span>🗺️ {{ translation.roadmap_title }}</span>
      </a>
    </div>
  </div>

  <!-- Hero Mascot Card (Authentic Ferris the Crab) -->
  <div class="hero-mascot-card">
    <div class="mascot-svg-wrap">
      <!-- Ferris Cozy — the kawaii semi-anime mascot, with twinkling
           sparkles (partials/fg_cozy_spark.tera). On a WRONG answer
           app.js swaps in the grumpy twin below (partials/fg_grumpy.tera). -->
      <svg id="mascot-cozy" class="fg-svg" width="170" height="145" viewBox="0 0 200 170" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Ferris">
        {% include "partials/fg_cozy_spark.tera" %}
      </svg>
      <svg id="mascot-grump" class="fg-svg" width="170" height="145" viewBox="0 0 200 170" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Angry Ferris" hidden>
        {% include "partials/fg_grumpy.tera" %}
      </svg>
    </div>
    <div class="mascot-speech">
      <span id="mascot-speech-text">
        🦀: {{ translation.mascot_initial_speech }}
      </span>
    </div>
    <div class="mascot-name">Ferris &bull; {{ translation.mascot_role }}</div>
  </div>
</section>

<!-- Device Adaptive Banner -->
<section class="adaptive-banner">
  <div class="banner-text">
    <div class="banner-title">
      <span>📐</span>
      <span>{{ translation.adaptive_title }}</span>
    </div>
    <p class="banner-desc">
      {{ translation.adaptive_desc }}
    </p>
  </div>
  <div class="devices-list">
    <div class="device-badge">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
        <line x1="8" y1="21" x2="16" y2="21"/>
        <line x1="12" y1="17" x2="12" y2="21"/>
      </svg>
      <span>{{ translation.device_desktop }}</span>
    </div>
    <div class="device-badge">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="4" y="2" width="16" height="20" rx="2" ry="2"/>
        <line x1="12" y1="18" x2="12.01" y2="18"/>
      </svg>
      <span>{{ translation.device_tablet }}</span>
    </div>
    <div class="device-badge">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
        <line x1="12" y1="18" x2="12.01" y2="18"/>
      </svg>
      <span>{{ translation.device_mobile }}</span>
    </div>
  </div>
</section>

<!-- Interactive First Spell Rust Playground -->
<section id="playground" class="playground-section">
  <div class="section-header">
    <div class="title-group">
      <div class="section-badge">{{ translation.playground_badge }}</div>
      <h2 class="section-title">{{ translation.playground_title }}</h2>
    </div>
    <div class="level-indicator">
      <span style="font-size: 0.9rem; color: var(--text-muted);">{{ translation.quest_label }}:</span>
      <strong style="color: var(--accent-primary);">#01 {{ translation.quest_mutability }}</strong>
      {% if user_stats.has_completed_first %}
      <span class="quest-done-tag">✅ {{ translation.quest_already_completed }}</span>
      {% endif %}
    </div>
  </div>

  <div class="spell-card">
    <div class="code-line">
      <span class="code-comment">// {{ translation.code_comment_1 }}</span>
    </div>
    <div class="code-line">
      <span class="code-comment">// {{ translation.code_comment_2 }}</span>
    </div>
    <div class="code-line">
      <span class="keyword">fn</span> <span class="func">main</span>() {
    </div>
    <div class="code-line">
      <span class="indent" style="white-space: pre-wrap;">    </span><span class="keyword">let</span> <form class="slot-field" autocomplete="off"><input type="text" id="slot-token" class="slot-real" maxlength="14" autocomplete="off" spellcheck="false" autocapitalize="off" aria-label="???" value="{% if user_stats.has_completed_first %}mut{% endif %}"><output for="slot-token" class="slot-input slot-mirror" data-placeholder="???">{% if user_stats.has_completed_first %}mut{% endif %}</output></form> <span>fairy_energy:</span> <span class="type">i32</span> <span class="symbol">=</span> <span class="type">100</span>;
    </div>
    <div class="code-line">
      <span class="indent" style="white-space: pre-wrap;">    </span><span>fairy_energy</span> <span class="symbol">+=</span> <span class="type">50</span>; <span class="code-comment">// 🌸 {{ translation.comment_increase }}</span>
    </div>
    <div class="code-line">
      <span class="indent" style="white-space: pre-wrap;">    </span><span class="func">println!</span>(<span class="string">"Energy: {}"</span>, fairy_energy);
    </div>
    <div class="code-line">
      }
    </div>
  </div>

  <div class="spell-controls">
    <a id="btn-cast-spell" class="btn-cast">
      <span>✨ {{ translation.btn_cast_spell }}</span>
    </a>
    <div id="spell-result" class="spell-result-box {% if user_stats.has_completed_first %}success{% else %}idle{% endif %}">
      {% if user_stats.has_completed_first %}
      <span>✨ {{ translation.quest_already_completed }}</span>
      {% else %}
      <span>💡 {{ translation.hint_prompt }}</span>
      {% endif %}
    </div>
  </div>
</section>

<!-- Future Language Worlds & Roadmap Section (Stage 2 Addition) -->
<section id="roadmap" class="roadmap-section">
  <div class="section-header">
    <div class="title-group">
      <div class="section-badge">{{ translation.roadmap_badge }}</div>
      <h2 class="section-title">{{ translation.roadmap_title }}</h2>
    </div>
    <p class="section-subtitle">{{ translation.roadmap_desc }}</p>
  </div>

  <div class="worlds-grid">
    <!-- 1. Rust (Active) -->
    <div class="world-card active">
      <div class="world-card-header">
        <div class="world-icon">🦀</div>
        <span class="world-status-pill active">{{ translation.world_rust_status }} ({{ version }})</span>
      </div>
      <h3 class="world-title">{{ translation.world_rust_title }}</h3>
      <p class="world-desc">{{ translation.world_rust_desc }}</p>
      <div class="world-meta">
        <span class="tag">Borrow Checker</span>
        <span class="tag">Zero Cost</span>
        <span class="tag">Memory Safe</span>
      </div>
    </div>

    <!-- 2. Python (In Development) -->
    <div class="world-card in-dev">
      <div class="world-card-header">
        <div class="world-icon">🐍</div>
        <span class="world-status-pill in-dev">{{ translation.world_python_status }}</span>
      </div>
      <h3 class="world-title">{{ translation.world_python_title }}</h3>
      <p class="world-desc">{{ translation.world_python_desc }}</p>
      <div class="world-meta">
        <span class="tag">OOP Magic</span>
        <span class="tag">Generators</span>
        <span class="tag">AsyncIO</span>
      </div>
    </div>

    <!-- 3. Node.js (Planned) -->
    <div class="world-card planned">
      <div class="world-card-header">
        <div class="world-icon">🟩</div>
        <span class="world-status-pill planned">{{ translation.world_node_status }}</span>
      </div>
      <h3 class="world-title">{{ translation.world_node_title }}</h3>
      <p class="world-desc">{{ translation.world_node_desc }}</p>
      <div class="world-meta">
        <span class="tag">Event Loop</span>
        <span class="tag">Streams</span>
        <span class="tag">V8 Engine</span>
      </div>
    </div>

    <!-- 4. Go (Planned) -->
    <div class="world-card planned">
      <div class="world-card-header">
        <div class="world-icon">🐹</div>
        <span class="world-status-pill planned">{{ translation.world_go_status }}</span>
      </div>
      <h3 class="world-title">{{ translation.world_go_title }}</h3>
      <p class="world-desc">{{ translation.world_go_desc }}</p>
      <div class="world-meta">
        <span class="tag">Goroutines</span>
        <span class="tag">Channels</span>
        <span class="tag">Fast Systems</span>
      </div>
    </div>
  </div>
</section>

<!-- PWA / Add to Home Screen Animated Widget Section -->
<section id="pwa-guide" class="pwa-widget-section">
  <div class="pwa-info">
    <div class="pwa-badge">📱 {{ translation.pwa_section_badge }}</div>
    <h2 class="pwa-title">{{ translation.pwa_title }}</h2>
    <p style="color: var(--text-secondary); line-height: 1.6;">
      {{ translation.pwa_desc }}
    </p>

    <div class="pwa-steps">
      <div class="pwa-step-item">
        <span class="step-num">1</span>
        <div class="step-content">
          <strong>{{ translation.step1_title }}:</strong> {{ translation.step1_desc }}
        </div>
      </div>
      <div class="pwa-step-item">
        <span class="step-num">2</span>
        <div class="step-content">
          <strong>{{ translation.step2_title }}:</strong> {{ translation.step2_desc }}
        </div>
      </div>
      <div class="pwa-step-item">
        <span class="step-num">3</span>
        <div class="step-content">
          <strong>{{ translation.step3_title }}:</strong> {{ translation.step3_desc }}
        </div>
      </div>
    </div>
  </div>

  <div class="pwa-phone-mockup">
    <div class="phone-notch"></div>
    <div class="phone-screen">
      <div style="font-size: 0.72rem; color: var(--text-muted); text-align: center; margin-top: 4px;">
        12:45 &bull; 5G
      </div>
      <div class="mock-widget-grid">
        <div class="mock-app-icon">Photos</div>
        <div class="mock-app-icon active-app">🦀 Ferris</div>
        <div class="mock-app-icon">Notes</div>
        <div class="mock-app-icon">Terminal</div>
        <div class="mock-app-icon">Music</div>
        <div class="mock-app-icon">Books</div>
      </div>

      <div class="mock-install-sheet">
        <div style="font-weight: 700; color: var(--accent-primary); margin-bottom: 3px;">
          ➕ {{ translation.sheet_add_button }}
        </div>
        <div style="font-size: 0.68rem; color: var(--text-muted);">
          "Ferris Garden" &bull; Desktop Widget
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ================================================================
     DEVICES & LANGUAGES — the garden follows you everywhere
     ================================================================ -->
<section class="feature-section" id="devices-section">
  <div class="section-header">
    <div class="title-group">
      <div class="section-badge">🪐 {{ translation.home_devices_badge }}</div>
      <h2 class="section-title">{{ translation.home_devices_title }}</h2>
    </div>
  </div>
  <p class="feature-desc">{{ translation.home_devices_desc }}</p>

  <div class="devices-stage">
    <div class="device-float device-phone">
      <svg class="fg-svg" width="64" height="96" viewBox="0 0 64 96" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="4" y="2" width="56" height="92" rx="10" class="dev-body"/>
        <rect x="9" y="10" width="46" height="68" rx="4" class="dev-screen"/>
        <rect class="dev-bar b1" x="14" y="18" width="34" height="6" rx="3"/>
        <rect class="dev-bar b2" x="14" y="28" width="26" height="6" rx="3"/>
        <rect class="dev-bar b3" x="14" y="38" width="30" height="6" rx="3"/>
        <circle class="dev-dot" cx="22" cy="58" r="6"/>
        <circle class="dev-dot dd2" cx="42" cy="58" r="6"/>
        <rect class="dev-bar b2" x="14" y="68" width="36" height="5" rx="2.5"/>
        <rect x="25" y="84" width="14" height="4" rx="2" class="dev-detail"/>
      </svg>
      <span class="device-label">{{ translation.home_devices_phone }}</span>
    </div>

    <div class="device-float device-tablet">
      <svg class="fg-svg" width="88" height="112" viewBox="0 0 88 112" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="4" y="2" width="80" height="108" rx="12" class="dev-body"/>
        <rect x="11" y="12" width="66" height="80" rx="4" class="dev-screen"/>
        <rect class="dev-bar b1" x="18" y="22" width="44" height="7" rx="3.5"/>
        <rect class="dev-bar b2" x="18" y="34" width="34" height="7" rx="3.5"/>
        <rect class="dev-bar b3" x="18" y="46" width="40" height="7" rx="3.5"/>
        <circle class="dev-dot" cx="28" cy="70" r="7"/>
        <circle class="dev-dot dd2" cx="52" cy="70" r="7"/>
        <circle cx="44" cy="103" r="4" class="dev-detail"/>
      </svg>
      <span class="device-label">{{ translation.home_devices_tablet }}</span>
    </div>

    <div class="device-float device-desktop">
      <svg class="fg-svg" width="132" height="100" viewBox="0 0 132 100" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="4" y="2" width="124" height="78" rx="8" class="dev-body"/>
        <rect x="11" y="9" width="110" height="64" rx="4" class="dev-screen"/>
        <rect class="dev-bar b1" x="20" y="18" width="52" height="7" rx="3.5"/>
        <rect class="dev-bar b2" x="20" y="30" width="40" height="7" rx="3.5"/>
        <rect class="dev-bar b3" x="20" y="42" width="58" height="7" rx="3.5"/>
        <rect x="20" y="56" width="30" height="10" rx="3" class="dev-btn"/>
        <path d="M56 80 L56 88 M76 80 L76 88 M46 90 L86 90" class="dev-stand"/>
      </svg>
      <span class="device-label">{{ translation.home_devices_pc }}</span>
    </div>
  </div>

  <svg class="sync-path fg-svg" viewBox="0 0 520 60" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" aria-hidden="true">
    <path class="sync-line" d="M30 46 C160 8 360 8 490 46"/>
    <circle class="sync-node" cx="30" cy="46" r="4"/>
    <circle class="sync-node" cx="260" cy="16" r="4"/>
    <circle class="sync-node" cx="490" cy="46" r="4"/>
  </svg>

  <div class="langs-strip">
    <div class="langs-mascot">
      <svg class="fg-svg" width="54" height="42" viewBox="0 0 18 14" shape-rendering="crispEdges" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Pixel Ferris">
        {% include "partials/fg_pixel.tera" %}
      </svg>
    </div>
    <div class="lang-bubble lb-en">EN</div>
    <div class="lang-bubble lb-ru">RU</div>
    <div class="lang-bubble lb-ko">한</div>
    <div class="langs-text">
      <h3 class="langs-title">{{ translation.home_langs_title }}</h3>
      <p class="langs-desc">{{ translation.home_langs_desc }}</p>
    </div>
  </div>
</section>

<!-- ================================================================
     ARTICLES — the Knowledge Codex
     ================================================================ -->
<section class="feature-section" id="articles-section">
  <div class="section-header">
    <div class="title-group">
      <div class="section-badge">📖 {{ translation.home_articles_badge }}</div>
      <h2 class="section-title">{{ translation.home_articles_title }}</h2>
    </div>
  </div>
  <p class="feature-desc">{{ translation.home_articles_desc }}</p>

  <div class="articles-chips">
    <div class="article-chip">🧭 {{ translation.home_articles_chip1 }}</div>
    <div class="article-chip">⚙️ {{ translation.home_articles_chip2 }}</div>
    <div class="article-chip">🛡️ {{ translation.home_articles_chip3 }}</div>
  </div>

  <div class="articles-cta-row">
    <div class="articles-mascot fg-bob">
      <svg class="fg-svg" width="132" height="112" viewBox="0 0 200 170" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Ferris reading">
        {% include "partials/fg_cozy_book.tera" %}
      </svg>
    </div>
    <a href="/codex?lang={{ lang }}" class="btn-codex">
      📖 {{ translation.home_articles_cta }}
    </a>
  </div>
</section>

<!-- ================================================================
     PLAY — with or without registration
     ================================================================ -->
<section class="feature-section" id="play-section">
  <div class="section-header">
    <div class="title-group">
      <div class="section-badge">🎮 {{ translation.home_play_badge }}</div>
      <h2 class="section-title">{{ translation.home_play_title }}</h2>
    </div>
  </div>
  <p class="feature-desc">{{ translation.home_play_desc }}</p>

  <div class="play-mascot">
    <svg class="fg-svg fg-bob" width="91" height="56" viewBox="0 0 26 16" shape-rendering="crispEdges" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Fairy Ferris">
      {% include "partials/fg_pixel_fairy.tera" %}
    </svg>
  </div>

  <div class="play-cards">
    <div class="play-card">
      <div class="play-icon">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="4" y="11" width="16" height="9" rx="2.5" class="lock-body"/>
          <path class="lock-open-shackle" d="M9 11 V7 a3.5 3.5 0 0 1 6.8 -1.2"/>
          <circle cx="12" cy="15.5" r="1.6" class="lock-key"/>
        </svg>
      </div>
      <h3 class="play-card-title">{{ translation.home_play_guest_title }}</h3>
      <p class="play-card-desc">{{ translation.home_play_guest_desc }}</p>
      <a href="#playground" class="btn-playmode">{{ translation.start_adventure }}</a>
    </div>

    <div class="play-card play-card-reg">
      <div class="play-icon">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="5" y="10" width="14" height="10" rx="2.5" class="lock-body"/>
          <path class="lock-shackle" d="M8.5 10 V6.5 a3.5 3.5 0 0 1 7 0 V10"/>
          <circle cx="12" cy="15" r="1.6" class="lock-key"/>
          <path class="lock-spark sp1" d="M20.5 3.5 l0.9 2.1 2.1 0.9 -2.1 0.9 -0.9 2.1 -0.9 -2.1 -2.1 -0.9 2.1 -0.9 z"/>
          <path class="lock-spark sp2" d="M3.5 6.5 l0.7 1.6 1.6 0.7 -1.6 0.7 -0.7 1.6 -0.7 -1.6 -1.6 -0.7 1.6 -0.7 z"/>
        </svg>
      </div>
      <h3 class="play-card-title">{{ translation.home_play_reg_title }}</h3>
      <p class="play-card-desc">{{ translation.home_play_reg_desc }}</p>
      <button type="button" class="btn-playmode" id="home-open-register">{{ translation.auth_register }}</button>
    </div>
  </div>
</section>

<!-- ================================================================
     PROGRESS SAFETY — guest progress transfer & cookie save
     ================================================================ -->
<section class="feature-section" id="progress-section">
  <div class="section-header">
    <div class="title-group">
      <div class="section-badge">🧺 {{ translation.home_progress_badge }}</div>
      <h2 class="section-title">{{ translation.home_progress_title }}</h2>
    </div>
  </div>
  <p class="feature-desc">{{ translation.home_progress_desc }}</p>

  <div class="progress-cards">
    <div class="progress-card">
      <svg class="pc-icon" width="46" height="46" viewBox="0 0 46 46" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="7" y="14" width="24" height="18" rx="5" class="cb-box"/>
        <path class="cb-check" d="M12 23 l6 6 l12 -13"/>
      </svg>
      <h3 class="progress-card-title">{{ translation.home_progress_transfer_title }}</h3>
      <p class="progress-card-desc">{{ translation.home_progress_transfer_desc }}</p>
      <div class="mock-keep"><span class="mock-box">🏡</span> my_garden</div>
    </div>

    <div class="progress-card">
      <svg class="pc-icon" width="46" height="46" viewBox="0 0 46 46" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="23" cy="25" r="13" class="cookie-body"/>
        <circle cx="18" cy="21" r="2.2" class="cookie-chip"/>
        <circle cx="27" cy="20" r="2" class="cookie-chip"/>
        <circle cx="24" cy="29" r="2.4" class="cookie-chip"/>
        <circle cx="30" cy="27" r="1.6" class="cookie-chip"/>
        <circle class="cookie-crumb c1" cx="38" cy="11" r="1.8"/>
        <circle class="cookie-crumb c2" cx="33" cy="6" r="1.4"/>
      </svg>
      <h3 class="progress-card-title">{{ translation.home_progress_cookie_title }}</h3>
      <p class="progress-card-desc">{{ translation.home_progress_cookie_desc }}</p>
      <div class="mock-keep"><span class="mock-box">🍪</span> fg_session &bull; ⛁</div>
    </div>
  </div>

  <div class="progress-mascot">
    <svg class="fg-svg fg-bob" width="54" height="42" viewBox="0 0 18 14" shape-rendering="crispEdges" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Pixel Ferris">
      {% include "partials/fg_pixel.tera" %}
    </svg>
  </div>
</section>

<!-- ================================================================
     FONTS & LIGATURES — Google Sans + JetBrains Mono
     ================================================================ -->
<section class="feature-section" id="fonts-section">
  <div class="section-header">
    <div class="title-group">
      <div class="section-badge">🅰️ {{ translation.home_fonts_badge }}</div>
      <h2 class="section-title">{{ translation.home_fonts_title }}</h2>
    </div>
  </div>
  <p class="feature-desc">{{ translation.home_fonts_desc }}</p>

  <div class="fonts-specimens">
    <div class="font-card fc-sans">
      <span class="font-glyph">Aa</span>
      <div class="font-meta">
        <span class="font-name">Google Sans</span>
        <span class="font-use">Ferris Garden 🌸</span>
      </div>
    </div>
    <div class="font-card fc-mono">
      <span class="font-glyph fg-mono-glyph">Aa</span>
      <div class="font-meta">
        <span class="font-name">JetBrains Mono</span>
        <span class="font-use fg-mono-use">let ferris = "🦀";</span>
      </div>
    </div>
  </div>

  <div class="lig-header">
    <p class="lig-hint">{{ translation.home_fonts_lig_hint }}</p>
    <div class="lig-mascot">
      <svg class="fg-svg fg-bob" width="54" height="42" viewBox="0 0 18 14" shape-rendering="crispEdges" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Pixel Ferris">
        {% include "partials/fg_pixel.tera" %}
      </svg>
    </div>
  </div>

  <div class="lig-table" id="lig-table">
    <div class="lig-row" style="--row-i: 0">
      <div class="lig-formula"><code>&lt;</code><span class="lig-op">+</span><code>=</code><span class="lig-eq">=</span><code class="lig-result">&lt;=</code></div>
      <div class="lig-typer" data-seq="<=" data-pause="1500"><span class="lig-typed"></span><span class="lig-caret"></span></div>
    </div>
    <div class="lig-row" style="--row-i: 1">
      <div class="lig-formula"><code>&gt;</code><span class="lig-op">+</span><code>=</code><span class="lig-eq">=</span><code class="lig-result">&gt;=</code></div>
      <div class="lig-typer" data-seq=">=" data-pause="1850"><span class="lig-typed"></span><span class="lig-caret"></span></div>
    </div>
    <div class="lig-row" style="--row-i: 2">
      <div class="lig-formula"><code>=</code><span class="lig-op">+</span><code>=</code><span class="lig-eq">=</span><code class="lig-result">==</code></div>
      <div class="lig-typer" data-seq="==" data-pause="2200"><span class="lig-typed"></span><span class="lig-caret"></span></div>
    </div>
    <div class="lig-row" style="--row-i: 3">
      <div class="lig-formula"><code>=</code><span class="lig-op">+</span><code>=</code><span class="lig-op">+</span><code>=</code><span class="lig-eq">=</span><code class="lig-result">===</code></div>
      <div class="lig-typer" data-seq="===" data-pause="2550"><span class="lig-typed"></span><span class="lig-caret"></span></div>
    </div>
    <div class="lig-row" style="--row-i: 4">
      <div class="lig-formula"><code>!</code><span class="lig-op">+</span><code>=</code><span class="lig-eq">=</span><code class="lig-result">!=</code></div>
      <div class="lig-typer" data-seq="!=" data-pause="1500"><span class="lig-typed"></span><span class="lig-caret"></span></div>
    </div>
    <div class="lig-row" style="--row-i: 5">
      <div class="lig-formula"><code>!</code><span class="lig-op">+</span><code>=</code><span class="lig-op">+</span><code>=</code><span class="lig-eq">=</span><code class="lig-result">!==</code></div>
      <div class="lig-typer" data-seq="!==" data-pause="2550"><span class="lig-typed"></span><span class="lig-caret"></span></div>
    </div>
    <div class="lig-row" style="--row-i: 6">
      <div class="lig-formula"><code>&lt;</code><span class="lig-op">+</span><code>!</code><span class="lig-op">+</span><code>-</code><span class="lig-op">+</span><code>-</code><span class="lig-eq">=</span><code class="lig-result">&lt;!--</code></div>
      <div class="lig-typer" data-seq="<!--" data-pause="2200"><span class="lig-typed"></span><span class="lig-caret"></span></div>
    </div>
    <div class="lig-row" style="--row-i: 7">
      <div class="lig-formula"><code>&lt;</code><span class="lig-op">+</span><code>#</code><span class="lig-op">+</span><code>-</code><span class="lig-op">+</span><code>-</code><span class="lig-eq">=</span><code class="lig-result">&lt;#--</code></div>
      <div class="lig-typer" data-seq="<#--" data-pause="2550"><span class="lig-typed"></span><span class="lig-caret"></span></div>
    </div>
    <div class="lig-row" style="--row-i: 8">
      <div class="lig-formula"><code>-</code><span class="lig-op">+</span><code>-</code><span class="lig-op">+</span><code>&gt;</code><span class="lig-eq">=</span><code class="lig-result">--&gt;</code></div>
      <div class="lig-typer" data-seq="-->" data-pause="2200"><span class="lig-typed"></span><span class="lig-caret"></span></div>
    </div>
    <div class="lig-row" style="--row-i: 9">
      <div class="lig-formula"><code>-</code><span class="lig-op">+</span><code>&gt;</code><span class="lig-eq">=</span><code class="lig-result">-&gt;</code></div>
      <div class="lig-typer" data-seq="->" data-pause="1500"><span class="lig-typed"></span><span class="lig-caret"></span></div>
    </div>
    <div class="lig-row" style="--row-i: 10">
      <div class="lig-formula"><code>&lt;</code><span class="lig-op">+</span><code>-</code><span class="lig-eq">=</span><code class="lig-result">&lt;-</code></div>
      <div class="lig-typer" data-seq="<-" data-pause="1850"><span class="lig-typed"></span><span class="lig-caret"></span></div>
    </div>
    <div class="lig-row" style="--row-i: 11">
      <div class="lig-formula"><code>=</code><span class="lig-op">+</span><code>&gt;</code><span class="lig-eq">=</span><code class="lig-result">=&gt;</code></div>
      <div class="lig-typer" data-seq="=>" data-pause="1850"><span class="lig-typed"></span><span class="lig-caret"></span></div>
    </div>
  </div>

  <form class="lig-play" id="lig-play-form" autocomplete="off">
    <label class="lig-play-label" for="lig-play-input">{{ translation.home_fonts_play_label }}</label>
    <div class="lig-play-stage">
      <!-- Chromium/Blink breaks JetBrains Mono ligatures inside <input> and
           [contenteditable] (typing right of a ligature visually eats its
           first glyph). The quest-runner workaround, reused: the real
           <input> is invisible (value holder for JS), the visible <output>
           mirror renders every ligature correctly. -->
      <input type="text" id="lig-play-input" name="lig_play" class="lig-play-real" maxlength="32"
        autocomplete="off" spellcheck="false" autocapitalize="off">
      <output for="lig-play-input" id="lig-play-mirror" class="lig-play-mirror"
        data-placeholder="{{ translation.home_fonts_play_placeholder }}"></output>
    </div>
    <div class="lig-play-meta"><span id="lig-play-count">0 / 32</span></div>
  </form>
</section>
{% endblock %}
